{% extends 'base.html.twig' %}

{% block title %}Edit Event{% endblock %}

{% block body %}
    <div class="mb-4">
        <h1>Éditer l'événement</h1>
        <p class="text-muted">Modification de l'événement #{{ event.id }}</p>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            {{ include('event/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>

    <div class="alert alert-danger" role="alert">
        <h5 class="alert-heading">Zone de danger</h5>
        <p>Cliquez ci-dessous pour supprimer définitivement cet événement.</p>
        {{ include('event/_delete_form.html.twig') }}
    </div>
{% endblock %}
