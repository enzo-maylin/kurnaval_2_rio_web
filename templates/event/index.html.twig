{% extends 'base.html.twig' %}

{% block title %}Event index{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Événements</h1>
        <a href="{{ path('app_event_new') }}" class="btn btn-primary">+ Créer un événement</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Description</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Localisation</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for event in events %}
            <tr>
                <td><span class="badge bg-secondary">{{ event.id }}</span></td>
                <td class="fw-bold">{{ event.title }}</td>
                <td>{{ event.description }}</td>
                <td>{{ event.startAt ? event.startAt|date('d/m/Y H:i') : '-' }}</td>
                <td>{{ event.endAt ? event.endAt|date('d/m/Y H:i') : '-' }}</td>
                <td>{{ event.location }}</td>
                <td class="text-center">
                    <a href="{{ path('app_event_show', {'id': event.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="btn btn-sm btn-warning">Éditer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center py-4 text-muted">
                    <em>Aucun événement trouvé</em>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
