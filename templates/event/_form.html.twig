{{ form_start(form) }}

    <div class="mb-3">
        {{ form_row(form.title, {'attr': {'class': 'form-control'}}) }}
    </div>

    <div class="mb-3">
        {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            {{ form_row(form.startAt, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.endAt, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="mb-3">
        {{ form_row(form.location, {'attr': {'class': 'form-control'}}) }}
    </div>

    {{ form_rest(form) }}

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            <button type="submit" class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
            <a href="{{ path('app_event_index') }}" class="btn btn-secondary ms-2">Annuler</a>
        </div>
    </div>

{{ form_end(form) }}
